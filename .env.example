# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Auth (NextAuth v5)
AUTH_SECRET=your-nextauth-secret-min-32-chars
AUTH_URL=https://your-app.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_ONE_TIME_PRICE_ID=price_your-one-time-price-id
STRIPE_SUBSCRIPTION_PRICE_ID=price_your-subscription-price-id

# Resend
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=BreakupBox <noreply@breakupbox.app>

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Cron security
CRON_SECRET=your-random-cron-secret-token

# ─────────────────────────────────────────────────────────
# DEMO MODE (Preview/Sandbox only — NEVER set in Production)
# Set both of these in Vercel → Project Settings → Environment
# Variables, scoped to "Preview" environments only.
# ─────────────────────────────────────────────────────────
# DEMO_MODE=true
# NEXT_PUBLIC_DEMO_MODE=true
